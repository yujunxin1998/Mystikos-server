<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mystikos</groupId>
        <artifactId>mystikos-server</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mystikos-app</artifactId>
    <packaging>jar</packaging>

    <!--
        启动壳：聚合所有限界上下文模块的唯一可执行 jar（MVP 单体部署形态）。
        拆分为独立微服务时，每个模块会拆出自己的启动壳，这里的依赖列表相应收窄。
    -->

    <dependencies>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-event</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-region</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-identity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-membership</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-provider-catalog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-booking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-commerce</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-gifting</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-relationship</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-payment</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-leaderboard</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-review</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-trust-safety</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-system-operation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Knife4j：只在最终可执行 jar 里引入，业务模块只需要 swagger-annotations-jakarta（见 mystikos-common） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <!--
        flyway-core 挪进 profile，不再是无条件依赖：
        - `local`（默认，不用显式指定）：带 Flyway，`spring.flyway.enabled=true` 时启动自动按
          deploy/sql/V1..N 增量迁移，本地开发/联调用这个。
        - `deploy`（`mvn package -Pdeploy` 显式指定）：不带 flyway-core——classpath 里没有这个类，
          Spring Boot 的 FlywayAutoConfiguration 直接不激活，启动完全不碰 Flyway，也不会去读
          deploy/sql/ 下的版本化脚本。线上/测试环境部署前手动执行一次 deploy/init.sql
          初始化数据库（見该文件顶部注释），之后的表结构变更由人工手动 ALTER，不再用这条 Flyway 路径。
        Maven 的 activeByDefault 规则：一旦命令行用 -P 显式激活了任何 profile（比如 -Pdeploy），
        activeByDefault 的 profile 会自动让位，不用额外传 -P!local 去关掉它。
    -->
    <profiles>
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-core</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>deploy</id>
        </profile>
    </profiles>

    <build>
        <finalName>mystikos-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <!--
                    repackage 目标不会自动绑定到 package 阶段——那是 spring-boot-starter-parent
                    才有的默认行为，本项目父 POM 是自己的 mystikos-server，得手动绑定，
                    不然 mvn package/install 产出的是个不能 java -jar 直接跑的普通 thin jar
                    （没有 Main-Class 清单），java -jar 会报"没有主清单条目"。
                -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
