<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mystikos</groupId>
        <artifactId>mystikos-server</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mystikos-payment</artifactId>
    <packaging>jar</packaging>

    <!-- 支付账本限界上下文：PaymentIntent/LedgerEntry/Wallet/WithdrawRequest，
         Stripe/支付宝/微信支付作为网关实现，见 PaymentGatewayRegistry。 -->

    <dependencies>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-event</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>4.40.272.ALL</version>
        </dependency>
        <dependency>
            <groupId>com.github.wechatpay-apiv3</groupId>
            <artifactId>wechatpay-java</artifactId>
            <version>0.2.17</version>
        </dependency>
        <dependency>
            <!-- 只用到独立 JUnit5 + Mockito，不起 Spring 容器，不需要 DB/Redis。 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
