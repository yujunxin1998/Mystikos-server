MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://116.62.218.227:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mystikos
MINIO_SERVER_URL=http://116.62.218.227:9000
MINIO_BROWSER_REDIRECT_URL=http://116.62.218.227:9001

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8099/api/v1/auth/oauth/discord/callback
OAUTH_FRONTEND_RETURN_URI=http://127.0.0.1:3000/auth
OAUTH_PROXY_HOST=
OAUTH_PROXY_PORT=0
# Stripe 测试模式密钥，去 https://dashboard.stripe.com/test/apikeys 申请，不要提交真实密钥。
STRIPE_SECRET_KEY=
# 本地用 `stripe listen --forward-to localhost:8099/api/v1/payments/webhooks/stripe` 时，
# 命令行会打印一个 whsec_ 开头的值，填这里。
STRIPE_WEBHOOK_SECRET=
# 逗号分隔，如 card 或 card,alipay,wechat_pay——后两者需要 Stripe 账户单独开通。
STRIPE_PAYMENT_METHOD_TYPES=card

# 支付宝开放平台直连（境内独立商户号），去 https://open.alipay.com 创建应用、生成 RSA2 密钥对。
# 留空 ALIPAY_APP_ID 时不会注册支付宝网关，调支付宝相关接口报"网关未配置"，不影响启动/不影响其他网关。
ALIPAY_APP_ID=
# 应用私钥（PKCS8，不带 PEM 头尾的纯 Base64），不要提交真实密钥。
ALIPAY_MERCHANT_PRIVATE_KEY=
# 支付宝公钥（注意不是应用公钥，是支付宝开放平台展示的"支付宝公钥"）。
ALIPAY_PUBLIC_KEY=
# 支付宝异步通知地址，必须公网可达 HTTPS，本地开发用内网穿透工具（如 ngrok）转发。
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 微信支付商户平台直连（境内独立商户号，APIv3），去 https://pay.weixin.qq.com 开通。
# 留空 WECHAT_MCH_ID 时不会注册微信支付网关，同上不影响启动/不影响其他网关。
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 商户 API 证书序列号，商户平台"API安全"页面可查。
WECHAT_MERCHANT_SERIAL_NO=
# 商户私钥文件路径（apiclient_key.pem），支持 classpath: 前缀；生产环境走 Docker volume/secret 挂载，
# 密钥文件本身不进 Git。
WECHAT_MERCHANT_PRIVATE_KEY_PATH=
# APIv3 密钥，商户平台"API安全"页面单独设置，不是证书密码。
WECHAT_API_V3_KEY=
# 微信支付异步通知地址，必须公网可达 HTTPS。
WECHAT_NOTIFY_URL=

# 登录密码 RSA 加密（见 README「登录密码 RSA 加密」一节）。本地开发默认关闭，直接用明文密码登录；
# 要在本地联调加密流程，先用 README 里的 openssl 命令生成一对密钥，再把下面两个路径改成实际文件路径
# （比如 deploy/keys/login/public-key.pem），并把 LOGIN_RSA_ENABLED 改成 true。
LOGIN_RSA_ENABLED=false
LOGIN_RSA_KEY_ID=login-key-v1
LOGIN_RSA_PUBLIC_KEY_PATH=
LOGIN_RSA_PRIVATE_KEY_PATH=

# 163 SMTP (use the client authorization code, not the webmail password)
MAIL_ENABLED=true
MAIL_SMTP_HOST=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=your-account@163.com
MAIL_SMTP_PASSWORD=your-163-authorization-code
MAIL_FROM=your-account@163.com
