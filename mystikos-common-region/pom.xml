<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mystikos</groupId>
        <artifactId>mystikos-server</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mystikos-common-region</artifactId>
    <packaging>jar</packaging>

    <!--
        行政区划参考数据（国家 + 一级行政区，两层树），纯只读、无业务不变量，
        跟 mystikos-common-storage（对象存储）同一个定位：通用技术能力，不是限界上下文，
        供任何业务模块按需依赖（目前是 mystikos-identity 的 User.regionCode）。
        数据来源与刷新方式见 deploy/sql 里对应的 Flyway 迁移文件注释。
    -->

    <dependencies>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
