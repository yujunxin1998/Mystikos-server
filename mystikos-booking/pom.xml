    <dependencies>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-common-event</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mystikos</groupId>
            <artifactId>mystikos-payment</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
